% Poemas
\RequirePackage{verse}
\RequirePackage{xcolor}
\RequirePackage{lineno}

\definecolor{poemgray}{RGB}{80, 80, 80}

\newcommand{\poemreference}{}

\newenvironment{poema}[3]
{
  \renewcommand{\poemreference}{#3}

  \begin{center}
    {\LARGE\bfseries #1\par}
    \vspace{0.5em}
    {\large\itshape #2\par}
    \vspace{2em}

    \begin{minipage}{0.70\textwidth}
      \raggedright
      \itshape
      \color{poemgray}
      \setlength{\parindent}{0pt}

      \internallinenumbers
}
{
      \nolinenumbers

    \end{minipage}

    \vspace{1.5em}

    \begin{minipage}{0.70\textwidth}
      \raggedright
      \hfill
      {\normalfont\small\color{black}\poemreference}
    \end{minipage}

  \end{center}
}
